# ===========================================
# Pharmacy OS Backend - Environment Variables
# Copy this file to .env and fill in your values
# ===========================================

# Server Configuration
PORT=8080
APP_ENV=development  # development, staging, production
LOG_LEVEL=info      # debug, info, warn, error

# Database (PostgreSQL via Supabase/Supavisor)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:6543/postgres

# Supabase Authentication
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret-here

# River Queue (Postgres-based job queue)
# Usually same as DATABASE_URL
RIVER_DSN=postgresql://postgres:postgres@localhost:6543/postgres

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Max Request Body Size (in bytes, default: 10MB)
MAX_REQUEST_SIZE=10485760
